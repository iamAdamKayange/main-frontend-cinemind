{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CineMind AI",
  "version": "0.1.0",
  "identifier": "ai.cinemind.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -w web",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build -w web",
    "frontendDist": "../../web/out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CineMind AI",
        "url": "/editor",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "theme": "Dark",
        "backgroundColor": "#111315"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["cinemind-desktop"] }
    }
  }
}
